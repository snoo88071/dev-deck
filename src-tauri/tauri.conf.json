{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Deck",
  "version": "0.1.0",
  "identifier": "dev.devdeck.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Deck",
        "width": 760,
        "height": 640,
        "minWidth": 420,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
